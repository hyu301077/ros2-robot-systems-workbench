<?xml version="1.0"?>
<?xml-model
  href="http://download.ros.org/schema/package_format3.xsd"
  schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>device_monitor</name>
  <version>0.1.0</version>
  <description>Monitors device status and reports battery and temperature alerts.</description>

  <maintainer email="284836894+hyu301077@users.noreply.github.com">hanyu</maintainer>
  <license>Apache-2.0</license>

  <!-- monitor 使用 rclcpp 创建订阅者，并使用接口 package 生成的 DeviceStatus 类型。 -->
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>robot_device_interfaces</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>

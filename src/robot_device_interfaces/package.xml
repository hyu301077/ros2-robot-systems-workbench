<?xml version="1.0"?>
<?xml-model
  href="http://download.ros.org/schema/package_format3.xsd"
  schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robot_device_interfaces</name>
  <version>0.1.0</version>
  <description>Custom message contracts for the ROS 2 device learning system.</description>

  <maintainer email="284836894+hyu301077@users.noreply.github.com">hanyu</maintainer>
  <license>Apache-2.0</license>

  <!-- 编译阶段由 rosidl 读取 .msg 并生成代码；运行阶段只需要生成后的类型支持。 -->
  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>
  <exec_depend>rosidl_default_runtime</exec_depend>

  <!-- ROS 2 用这个分组识别“接口 package”，便于接口生成和依赖检查。 -->
  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
